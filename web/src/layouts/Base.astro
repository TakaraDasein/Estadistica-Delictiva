---
import "@/styles/global.css";

interface Props { title: string; description?: string }
const { title, description = "Observatorio de estadística delictiva de Colombia 2010–2024: tendencias, territorio, perfiles y respuesta institucional." } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const path = Astro.url.pathname.replace(base, "") || "/";
const nav = [
  ["/", "Relato"],
  ["/tiempo", "Tiempo"],
  ["/territorio", "Territorio"],
  ["/perfiles", "Perfiles"],
  ["/relaciones", "Relaciones"],
  ["/respuesta", "Respuesta"],
  ["/delitos", "Delitos"],
  ["/metodologia", "Metodología"],
];
const active = (href: string) => (href === "/" ? path === "/" : path.startsWith(href));
---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <title>{title} · Observatorio delictivo</title>
    <link rel="icon" href={`${base}/favicon.svg`} type="image/svg+xml" />
    <script is:inline>
      try { const t = localStorage.getItem("theme"); if (t) document.documentElement.dataset.theme = t; } catch {}
    </script>
  </head>
  <body>
    <header class="top">
      <div class="wrap">
        <a class="brand" href={`${base}/`}>Observatorio delictivo</a>
        <nav class="nav" aria-label="Capítulos">
          {nav.map(([href, label]) => (
            <a href={`${base}${href}`} aria-current={active(href) ? "page" : undefined}>{label}</a>
          ))}
        </nav>
        <button class="theme-btn" id="theme" aria-label="Cambiar tema claro/oscuro">◐</button>
      </div>
    </header>
    <main class="wrap"><slot /></main>
    <footer class="wrap foot">
      Fuente: DIJIN – Policía Nacional de Colombia (estadística delictiva y resultados operativos 2010–2024);
      población: DANE, proyecciones censo 2018. Cifras sujetas a variación. Procesamiento reproducible en
      <code>pipeline/</code> · ver <a href={`${base}/metodologia`}>metodología</a>.
    </footer>
    <script is:inline>
      document.getElementById("theme").addEventListener("click", () => {
        const root = document.documentElement;
        const dark = root.dataset.theme ? root.dataset.theme === "dark" : matchMedia("(prefers-color-scheme: dark)").matches;
        root.dataset.theme = dark ? "light" : "dark";
        try { localStorage.setItem("theme", root.dataset.theme); } catch {}
        window.dispatchEvent(new Event("themechange"));
      });
    </script>
  </body>
</html>
